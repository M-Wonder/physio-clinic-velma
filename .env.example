# ================================================================
# Neuromotion Physiotherapy Clinic — environment variables
# Copy to .env and fill in. Never commit .env.
# ================================================================

# --- Django core ---
SECRET_KEY=replace-with-50-char-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
DJANGO_ENV=development
TIME_ZONE=Africa/Nairobi

# --- PostgreSQL ---
POSTGRES_DB=physio_clinic
POSTGRES_USER=physio_user
POSTGRES_PASSWORD=choose-a-strong-password
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- Redis ---
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# --- JWT ---
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=15
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# --- Email (dev prints to the terminal; use SMTP in production) ---
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Neuromotion Physiotherapy Clinic <neuromotionphysio@gmail.com>

# --- Twilio SMS (optional — leave blank to disable) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# --- Patient-data encryption: REQUIRED when DEBUG=False (app refuses to start without it) ---
# python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=replace-with-generated-fernet-key

# --- Frontend --- leave VITE_API_URL blank for local Docker (Vite proxies /api)
VITE_API_URL=

# --- Clinic identity (shown on the site and in emails/SMS; served at /api/clinic/) ---
CLINIC_NAME=Neuromotion Physiotherapy Clinic
CLINIC_TAGLINE=Move Better. Feel Better.
# Blank fields are simply hidden on the site. Fill in the REAL values before launch:
CLINIC_PHONE=
CLINIC_WHATSAPP=
CLINIC_EMAIL=neuromotionphysio@gmail.com
CLINIC_ADDRESS=Nairobi, Kenya
CLINIC_SOCIAL_HANDLE=neuromotionphysio

# --- Rates in KES per session ---
CLINIC_SESSION_FEE=4500
CLINIC_HOME_VISIT_FEE=5500

# --- Booking rules ---
APPOINTMENT_DURATION_MINUTES=60
BOOKING_ADVANCE_DAYS=30
CANCELLATION_NOTICE_HOURS=24
